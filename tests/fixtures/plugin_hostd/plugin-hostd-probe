#!/bin/sh
# Stand-in for plugin-hostd-probe: describe <target> prints the file PROBE_STUB_DESCRIPTOR.
# Shell builtins only: the tests' PATH holds python3 and nothing else.
echo "$@" >>"$PROBE_STUB_LOG"
[ "$1" = describe ] && [ -z "$PROBE_STUB_FAIL" ] || exit 3
while IFS= read -r line; do echo "$line"; done <"$PROBE_STUB_DESCRIPTOR"
